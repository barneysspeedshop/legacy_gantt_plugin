{
  "name": "legacy-gantt-plugin",
  "displayName": "Legacy Gantt Plugin",
  "description": "VS Code extension for Gantt-Sync Protocol",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:legacy-gantt-plugin.showGantt"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "legacy-gantt-plugin.showGantt",
        "title": "Legacy Gantt Plugin: Show Legacy Gantt"
      }
    ],
    "configuration": {
      "title": "Legacy Gantt",
      "properties": {
        "legacyGantt.serverUrl": {
          "type": "string",
          "default": "ws://localhost:8080/ws",
          "description": "WebSocket URL for the Gantt Sync Server"
        },
        "legacyGantt.tenantId": {
          "type": "string",
          "default": "default-tenant",
          "description": "Tenant ID for synchronization scope"
        },
        "legacyGantt.jvmAuthToken": {
          "type": "string",
          "default": "",
          "description": "JWT Auth Token for the server (Dev only)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --max-warnings 0",
    "test": "npm run compile && npm run lint && node test/sync.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.146.0",
    "@types/ws": "^8.18.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "ws": "^8.23.0"
  },
  "private": true
}
